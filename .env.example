# DeepSeek API（兼容 OpenAI Chat Completions）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 应用
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite:///./data/tracker.db

# 采集调度（分钟）——服务端拉 mock/csv/http_json 用
COLLECT_INTERVAL_MINUTES=60

# 本机采集端推送鉴权（POST /api/ingest/prices）
# 与 local_collector/config.json 的 token 保持一致
INGEST_TOKEN=
# 入库时是否自动加入关注列表（1/0）
INGEST_AUTO_WATCH=1

# 价格过滤阈值（可调）
FILTER_MIN_PRICE=50
FILTER_MAX_PRICE=100000
FILTER_MEDIAN_DEVIATION_RATIO=0.55
FILTER_ZSCORE_THRESHOLD=3.5

# 强制离线（测试用）：设为 1 时禁用 LLM
FORCE_OFFLINE=0
